    "locales": true,
    "bundle": {
      "vendor": {
        "marked": "components/display/marked-vendor.js"
      }
    },
    "test": {
      "browser": true,
      "ignore": [
        "website/**"
      ]
    },
    "check": {
      "from": [
        "bootstrapp",
        "@bootstrapp/check"
      ],
      "ignore": [
        "website/",
        "native/desktop/out/"
      ],
      "rules": {
        "view/no-raw-localstorage": "off",
        "light/no-any": "error",
        "light/declare-instance-surface": "error"
      },
      "noAny": {},
      "perf": {
        "scope": [
          "html/",
          "signals/",
          "view/",
          "tdom/",
          "controller/",
          "model/",
          "dom/"
        ],
        "native": [
          "html/",
          "signals/",
          "view/core.ts",
          "tdom/",
          "controller/",
          "model/"
        ],
        "hot": [
          "signals/index.ts#Dep._track",
          "signals/index.ts#Dep._notify",
          "signals/index.ts#Reactive._execute",
          "html/template.ts#TemplateInstance.commit",
          "html/parts.ts#AttributePart.setFromValues",
          "html/parts.ts#AttributePart.commit",
          "html/parts.ts#BooleanAttributePart.commit",
          "html/parts.ts#RawTextPart.commit",
          "html/parts.ts#ChildPart.setFromValues",
          "html/parts.ts#ChildPart.commit",
          "html/parts.ts#ChildPart._commitResolved",
          "html/parts.ts#ChildPart._commitItems",
          "html/parts.ts#ChildPart._reconcileKeyed",
          "view/core.ts#enqueueUpdate",
          "view/core.ts#flushUpdates",
          "view/core.ts#ViewCore.$requestUpdate",
          "view/core.ts#ViewCore.$schedule",
          "view/core.ts#ViewCore.$flushUpdate",
          "view/core.ts#ViewCore.$performUpdate",
          "view/core.ts#ViewCore.$update",
          "tdom/node.ts#TElement.setProp",
          "tdom/node.ts#TElement.handle",
          "tdom/node.ts#TBox.setOwnProp",
          "tdom/layout.ts#measure",
          "tdom/layout.ts#measureBox",
          "tdom/layout.ts#arrange",
          "tdom/paint.ts#paint",
          "tdom/paint.ts#putClipped",
          "tdom/renderer.ts#Renderer.autofocus",
          "tdom/renderer.ts#Renderer.renderFrame",
          "tdom/screen.ts#Screen.put",
          "tdom/screen.ts#Screen.fill"
        ]
      },
      "allow": {
        "light/perf-no-delete": {
          "dom/view.js#View.$initProps": "a property set on the element before it upgraded is an own data property that shadows the accessor; only delete removes it",
          "controller/writers.ts#writableRecord": "the record is handed to callers as a plain object, so removing a key must remove the property"
        },
        "light/no-any": {
          "components/display/marked-vendor.js": "the vendored marked build, copied as published; light does not edit or type it"
        },
        "light/perf-exception-flow": {
          "controller/adapters/storage.ts#deserialize": "a stored value is parsed only when it starts like JSON, so the catch meets malformed JSON only",
          "model/jsonl.ts#readLines": "every line of a JSONL file is JSON unless the file is corrupt; the catch marks it for compaction"
        },
        "light/perf-hot-allocation": {
          "html/parts.ts#ChildPart._commitItems": "measured (native/probes/pairs keyed-map): .map sizes its result once, and a loop pushing into two arrays ran 1.9x slower natively; the slice keeps the part list whole for _clear when a commit throws mid-reconcile",
          "view/core.ts#flushUpdates": "the comparator is made once per flush that orders more than one view, not once per view"
        }
      }
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "scriptc"
    ]
  }
}
