{
  "name": "@bootstrapp/light",
  "version": "0.1.0",
  "description": "Light-DOM web components from object definitions, with reactive properties, a tagged-template renderer, signals, property types, a theme engine and a component library.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "light": "./bin/light.js"
  },
  "exports": {
    ".": {
      "types": "./view/types.ts",
      "default": "./view/index.js"
    },
    "./view/core": "./view/core.ts",
    "./dom": {
      "types": "./dom/types.ts",
      "default": "./dom/index.js"
    },
    "./markup": "./markup/index.js",
    "./tdom": "./tdom/index.ts",
    "./native": "./native/index.ts",
    "./native/desktop": "./native/desktop/index.ts",
    "./html": {
      "types": "./html/types.ts",
      "default": "./html/index.js"
    },
    "./html/core": "./html/core.ts",
    "./signals": {
      "types": "./signals/types.ts",
      "default": "./signals/index.ts"
    },
    "./types": "./types/types.ts",
    "./env": {
      "types": "./env/types.ts",
      "default": "./env/index.js"
    },
    "./navigation": {
      "types": "./navigation/types.ts",
      "default": "./navigation/index.js"
    },
    "./theme": {
      "types": "./theme/types.ts",
      "default": "./theme/index.js"
    },
    "./theme/tokens": "./theme/tokens.ts",
    "./theme/terminal": "./theme/terminal.ts",
    "./theme/baked": "./theme/baked.ts",
    "./theme/classes": {
      "types": "./theme/classes/types.ts",
      "default": "./theme/classes/index.js"
    },
    "./theme/palette": "./theme/classes/palette.js",
    "./theme/runtime": {
      "types": "./theme/runtime-types.ts",
      "default": "./theme/runtime.js"
    },
    "./check": {
      "types": "./check/types.ts",
      "default": "./check/define.js"
    },
    "./eslint": {
      "types": "./eslint/types.ts",
      "default": "./eslint/index.js"
    },
    "./controller": {
      "types": "./controller/types.ts",
      "default": "./controller/index.ts"
    },
    "./controller/resource": "./controller/resource.ts",
    "./controller/storage": "./controller/adapters/storage.ts",
    "./controller/document": "./controller/adapters/document.ts",
    "./controller/url": "./controller/adapters/url.ts",
    "./controller/view": "./controller/view.ts",
    "./controller/class": "./controller/class.ts",
    "./model": {
      "types": "./model/types.ts",
      "default": "./model/index.ts"
    },
    "./model/store": "./model/store.ts",
    "./model/adapter": "./model/adapter.ts",
    "./model/indexeddb": "./model/indexeddb.ts",
    "./model/jsonl": "./model/jsonl.ts",
    "./model/binder": "./model/binder.ts",
    "./model/slug": "./model/slug.ts",
    "./model/events": "./model/events.ts",
    "./html/constants.js": "./html/constants.ts",
    "./html/parser.js": "./html/parser.ts",
    "./html/values.js": "./html/values.ts",
    "./html/host.js": "./html/host.ts",
    "./html/template.js": "./html/template.ts",
    "./html/parts.js": "./html/parts.ts",
    "./html/reactive.js": "./html/reactive.ts",
    "./html/core.js": "./html/core.ts",
    "./html/tokenizer.js": "./html/tokenizer.ts",
    "./signals/index.js": "./signals/index.ts",
    "./signals/store.js": "./signals/store.ts",
    "./view/core.js": "./view/core.ts",
    "./*": "./*"
  },
  "scripts": {
    "pack": "node scripts/pack.js",
    "bench": "node benchmarks/run.js",
    "lint": "eslint .",
    "typecheck": "tsc-ts --noEmit",
    "typecheck:native": "tsc-ts -p native",
    "typecheck:desktop": "tsc-ts -p native/desktop",
    "typecheck:any": "node scripts/any-report.js",
    "coverage:native": "node native/coverage.js",
    "coverage:tasks": "node native/coverage.js examples/tasks/main.js --allow-dynamic",
    "bake:tasks": "node bin/light.js classes:bake examples/tasks/main.js -o examples/tasks/classes.baked.js --scheme dark,light",
    "coverage:desktop": "node native/desktop/coverage.js",
    "test:native": "node native/run.js",
    "test:desktop": "node native/desktop/smoke.js",
    "check": "node bin/light.js check",
    "test": "node --test check/*.test.js check/parse/*.test.js check/rules/*.test.js eslint/*.test.js eslint/rules/*.test.js view/definition.test.js $(find controller -name \"*.test.js\" -not -name \"*.browser.test.js\") $(find model -name \"*.test.js\" -not -name \"*.browser.test.js\") navigation/*.test.js signals/*.test.js theme/variant-rules.test.js theme/tokens.test.js theme/classes/*.test.js theme/runtime.test.js theme/imports.test.js theme/terminal.test.js theme/baked.test.js theme/bake.test.js types/*.test.js test/*.test.js html/conformance.test.js markup/markup.test.js view/core.test.js $(find components -name \"*.test.js\" -not -name \"*.browser.test.js\") && node bin/light.js test env/*.browser.test.js html/*.browser.test.js markup/*.browser.test.js theme/*.browser.test.js view/*.browser.test.js controller/*.browser.test.js model/*.browser.test.js components/*/*.browser.test.js",
    "probes": "node native/probes/run.js",
    "verify": "npm run lint && npm run typecheck && npm run typecheck:native && npm run typecheck:desktop && npm run typecheck:any && npm run coverage:native && npm run coverage:tasks && npm run coverage:desktop && npm run check && npm test && npm run test:native && npm run test:desktop && npm run bake:tasks -- --check"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^2.13.0",
    "@types/node": "^26.6.5",
    "eslint": "^9.17.0",
    "eslint-plugin-lit": "^2.3.1",
    "globals": "^15.14.0",
    "marked": "^18.1.0",
    "playwright": "^1.58.2",
    "scriptc": "0.4.1",
    "tsc-ts": "0.0.5",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@stylistic/eslint-plugin": "^2.13.0",
    "eslint": "^9.17.0",
    "eslint-plugin-lit": "^2.3.1",
    "globals": "^15.14.0",
    "typescript": "^6.0.3"
  },
