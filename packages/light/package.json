{
  "name": "@lightstart/light",
  "version": "0.1.0",
  "description": "Light-DOM web components from object definitions, with reactive properties, a tagged-template renderer, signals, property types, a theme engine and a component library.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://lightstart.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alantriesagain/light.git",
    "directory": "packages/light"
  },
  "bugs": {
    "url": "https://github.com/alantriesagain/light/issues"
  },
  "keywords": [
    "web-components",
    "custom-elements",
    "light-dom",
    "signals",
    "renderer",
    "ui",
    "framework"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "light": "./bin/light.js"
  },
  "exports": {
    ".": {
      "types": "./view/types.ts",
      "default": "./view/index.js"
    },
    "./view/core": "./view/core.ts",
    "./dom": {
      "types": "./dom/types.ts",
      "default": "./dom/index.js"
    },
    "./markup": "./markup/index.js",
    "./markup/core": "./markup/core.ts",
    "./native/tui": "./native/tui/index.ts",
    "./native/desktop": "./native/desktop/index.ts",
    "./html": {
      "types": "./html/types.ts",
      "default": "./html/index.js"
    },
    "./html/core": "./html/core.ts",
    "./signals": {
      "types": "./signals/types.ts",
      "default": "./signals/index.ts"
    },
    "./types": "./types/types.ts",
    "./env": {
      "types": "./env/types.ts",
      "default": "./env/index.js"
    },
    "./navigation": {
      "types": "./navigation/types.ts",
      "default": "./navigation/index.js"
    },
    "./theme": {
      "types": "./theme/types.ts",
      "default": "./theme/index.js"
    },
    "./theme/tokens": "./theme/tokens.ts",
    "./theme/terminal": "./theme/terminal.ts",
    "./theme/baked": "./theme/baked.ts",
    "./theme/classes": {
      "types": "./theme/classes/types.ts",
      "default": "./theme/classes/index.js"
    },
    "./theme/palette": "./theme/classes/palette.js",
    "./theme/runtime": {
      "types": "./theme/runtime-types.ts",
      "default": "./theme/runtime.js"
    },
    "./check": {
      "types": "./check/types.ts",
      "default": "./check/define.js"
    },
    "./eslint": {
      "types": "./eslint/types.ts",
      "default": "./eslint/index.js"
    },
    "./controller": {
      "types": "./controller/types.ts",
      "default": "./controller/index.ts"
    },
    "./controller/resource": "./controller/resource.ts",
    "./controller/storage": "./controller/adapters/storage.ts",
    "./controller/document": "./controller/adapters/document.ts",
    "./controller/url": "./controller/adapters/url.ts",
    "./controller/view": "./controller/view.ts",
    "./controller/class": "./controller/class.ts",
    "./model": {
      "types": "./model/types.ts",
      "default": "./model/index.ts"
    },
    "./model/store": "./model/store.ts",
    "./model/adapter": "./model/adapter.ts",
    "./model/indexeddb": "./model/indexeddb.ts",
    "./model/jsonl": "./model/jsonl.ts",
    "./model/sql": "./model/sql.ts",
    "./model/sql-builder": "./model/sql-builder.ts",
    "./model/binder": "./model/binder.ts",
    "./model/slug": "./model/slug.ts",
    "./model/events": "./model/events.ts",
    "./html/constants.js": "./html/constants.ts",
    "./html/parser.js": "./html/parser.ts",
    "./html/values.js": "./html/values.ts",
    "./html/host.js": "./html/host.ts",
    "./html/template.js": "./html/template.ts",
    "./html/parts.js": "./html/parts.ts",
    "./html/reactive.js": "./html/reactive.ts",
    "./html/core.js": "./html/core.ts",
    "./html/tokenizer.js": "./html/tokenizer.ts",
    "./signals/index.js": "./signals/index.ts",
    "./signals/store.js": "./signals/store.ts",
    "./view/core.js": "./view/core.ts",
    "./*": "./*"
  },
  "scripts": {
    "pack": "node scripts/pack.js",
    "typecheck": "tsc-ts --noEmit",
    "typecheck:native": "tsc-ts -p native/tui",
    "typecheck:desktop": "tsc-ts -p native/desktop",
    "typecheck:any": "node scripts/any-report.js",
    "coverage:native": "node native/coverage.js",
    "coverage:desktop": "node native/desktop/coverage.js",
    "test:native": "node native/run.js",
    "test:desktop": "node native/desktop/smoke.js",
    "check": "node bin/light.js check",
    "test": "node --test check/*.test.js check/parse/*.test.js check/rules/*.test.js eslint/*.test.js eslint/rules/*.test.js view/definition.test.js $(find controller -name \"*.test.js\" -not -name \"*.browser.test.js\") $(find model -name \"*.test.js\" -not -name \"*.browser.test.js\") navigation/*.test.js signals/*.test.js theme/variant-rules.test.js theme/tokens.test.js theme/classes/*.test.js theme/runtime.test.js theme/imports.test.js theme/terminal.test.js theme/baked.test.js theme/bake.test.js types/*.test.js test/*.test.js html/conformance.test.js markup/markup.test.js view/core.test.js && node bin/light.js test env/*.browser.test.js html/*.browser.test.js markup/*.browser.test.js theme/*.browser.test.js view/*.browser.test.js controller/*.browser.test.js model/*.browser.test.js",
    "probes": "node native/probes/run.js",
    "verify": "npm run typecheck && npm run typecheck:native && npm run typecheck:desktop && npm run typecheck:any && npm run coverage:native && npm run coverage:desktop && npm run check && npm test && npm run test:native && npm run test:desktop"
  },
  "devDependencies": {
    "@lightstart/components": "workspace:*",
    "@lightstart/server": "workspace:*",
    "@lightstart/sqlite": "workspace:*",
    "@stylistic/eslint-plugin": "^2.13.0",
    "@types/node": "^26.6.5",
    "eslint": "^9.17.0",
    "eslint-plugin-lit": "^2.3.1",
    "globals": "^15.14.0",
    "marked": "^18.1.0",
    "playwright": "^1.58.2",
    "scriptc": "0.4.2",
    "tsc-ts": "0.0.8",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@lightstart/server": "^0.1.0",
    "@lightstart/sqlite": "^0.1.0",
    "@stylistic/eslint-plugin": "^2.13.0",
    "eslint": "^9.17.0",
    "eslint-plugin-lit": "^2.3.1",
    "globals": "^15.14.0",
    "typescript": "^6.0.3 || ^7.0.0"
  },
  "peerDependenciesMeta": {
    "@lightstart/server": {
      "optional": true
    },
    "@lightstart/sqlite": {
      "optional": true
    },
    "@stylistic/eslint-plugin": {
      "optional": true
    },
    "eslint": {
      "optional": true
    },
    "eslint-plugin-lit": {
      "optional": true
    },
    "globals": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "bootstrapp": {
    "check": {
      "from": [
        "bootstrapp",
        "@bootstrapp/check"
      ],
      "ignore": [
        "website/",
        "native/desktop/out/"
      ],
      "rules": {
        "light/no-any": "error",
        "light/declare-instance-surface": "error"
      },
      "noAny": {},
      "perf": {
        "scope": [
          "html/",
          "signals/",
          "view/",
          "native/tui/",
          "controller/",
          "model/",
          "dom/"
        ],
        "native": [
          "html/",
          "signals/",
          "view/core.ts",
          "native/tui/",
          "controller/",
          "model/"
        ],
        "hot": [
          "signals/index.ts#Dep._track",
          "signals/index.ts#Dep._notify",
          "signals/index.ts#Reactive._execute",
          "html/template.ts#TemplateInstance.commit",
          "html/parts.ts#AttributePart.setFromValues",
          "html/parts.ts#AttributePart.commit",
          "html/parts.ts#BooleanAttributePart.commit",
          "html/parts.ts#RawTextPart.commit",
          "html/parts.ts#ChildPart.setFromValues",
          "html/parts.ts#ChildPart.commit",
          "html/parts.ts#ChildPart._commitResolved",
          "html/parts.ts#ChildPart._commitItems",
          "html/parts.ts#ChildPart._reconcileKeyed",
          "view/core.ts#enqueueUpdate",
          "view/core.ts#flushUpdates",
          "view/core.ts#ViewCore.$requestUpdate",
          "view/core.ts#ViewCore.$schedule",
          "view/core.ts#ViewCore.$flushUpdate",
          "view/core.ts#ViewCore.$performUpdate",
          "view/core.ts#ViewCore.$update",
          "native/tui/node.ts#TElement.setProp",
          "native/tui/node.ts#TElement.handle",
          "native/tui/node.ts#TBox.setOwnProp",
          "native/tui/layout.ts#measure",
          "native/tui/layout.ts#measureBox",
          "native/tui/layout.ts#arrange",
          "native/tui/paint.ts#paint",
          "native/tui/paint.ts#putClipped",
          "native/tui/renderer.ts#Renderer.autofocus",
          "native/tui/renderer.ts#Renderer.renderFrame",
          "native/tui/screen.ts#Screen.put",
          "native/tui/screen.ts#Screen.fill"
        ]
      },
      "allow": {
        "light/perf-no-delete": {
          "dom/view.js#View.$initProps": "a property set on the element before it upgraded is an own data property that shadows the accessor; only delete removes it",
          "controller/writers.ts#writableRecord": "the record is handed to callers as a plain object, so removing a key must remove the property"
        },
        "light/perf-exception-flow": {
          "controller/adapters/storage.ts#deserialize": "a stored value is parsed only when it starts like JSON, so the catch meets malformed JSON only",
          "model/jsonl.ts#readLines": "every line of a JSONL file is JSON unless the file is corrupt; the catch marks it for compaction"
        },
        "light/perf-hot-allocation": {
          "html/parts.ts#ChildPart._commitItems": "measured (native/probes/pairs keyed-map): .map sizes its result once, and a loop pushing into two arrays ran 1.9x slower natively; the slice keeps the part list whole for _clear when a commit throws mid-reconcile",
          "view/core.ts#flushUpdates": "the comparator is made once per flush that orders more than one view, not once per view"
        }
      }
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "scriptc"
    ]
  }
}
