{
  "name": "@lightstart/admin",
  "version": "0.1.0",
  "description": "A project admin as an app extension: the shell, the slots tools fill, files and history over the project's allowed folders, and a guarded dev file API on light serve.",
  "type": "module",
  "types": "./index.ts",
  "license": "MIT",
  "homepage": "https://lightstart.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alantriesagain/light.git",
    "directory": "packages/admin"
  },
  "bugs": {
    "url": "https://github.com/alantriesagain/light/issues"
  },
  "keywords": [
    "admin",
    "files",
    "editor",
    "dev-server",
    "light"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "index.ts",
    "extension.ts",
    "slots.ts",
    "paths.ts",
    "files.ts",
    "history.ts",
    "state.ts",
    "dialogs.ts",
    "tags.json",
    "views/",
    "cli/",
    "node/",
    "README.md",
    "AGENTS.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./index.ts",
    "./extension.ts": "./extension.ts",
    "./node": "./node/index.ts",
    "./*": "./*"
  },
  "light": {
    "extension": "./extension.ts",
    "devOnly": true,
    "tags": "tags.json"
  },
  "dependencies": {
    "@lightstart/app": "workspace:*",
    "@lightstart/cli": "workspace:*",
    "@lightstart/components": "workspace:*",
    "@lightstart/dev": "workspace:*",
    "@lightstart/light": "workspace:*",
    "@lightstart/router": "workspace:*",
    "@lightstart/server": "workspace:*",
    "@lightstart/test": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^6.0.3"
  }
}
