{
  "name": "@lightstart/maps",
  "version": "0.1.0",
  "description": "A slippy map over self-hosted raster tiles, with drop pins, clustering and keyless geocoding.",
  "type": "module",
  "types": "./types.ts",
  "license": "MIT",
  "homepage": "https://lightstart.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alantriesagain/light.git",
    "directory": "packages/maps"
  },
  "bugs": {
    "url": "https://github.com/alantriesagain/light/issues"
  },
  "keywords": [
    "maps",
    "geocoding",
    "places",
    "nominatim",
    "openstreetmap",
    "web-components",
    "light"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "index.ts",
    "types.ts",
    "geocode.js",
    "locate.js",
    "links.js",
    "mercator.js",
    "coverage.js",
    "offline.js",
    "engine.js",
    "points.js",
    "engine/",
    "lib/",
    "controllers/",
    "views/",
    "cli/",
    "tags.json",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./index.ts",
    "./*": "./*"
  },
  "light": {
    "tags": "tags.json"
  },
  "dependencies": {
    "@lightstart/app": "workspace:*",
    "@lightstart/cli": "workspace:*",
    "@lightstart/components": "workspace:*",
    "@lightstart/content": "workspace:*",
    "@lightstart/light": "workspace:*",
    "@lightstart/router": "workspace:*"
  },
  "devDependencies": {
    "@lightstart/build": "workspace:*",
    "@lightstart/test": "workspace:*",
    "@types/node": "^26.6.5",
    "typescript": "^6.0.3"
  }
}
