{
  "name": "@lightstart/devices",
  "version": "0.1.0",
  "description": "Connected devices for light apps: a driver registry, a devices controller, generic BLE/Wi-Fi/download/preview transports over the mobile shell, and the devices-* views.",
  "type": "module",
  "types": "./types.ts",
  "license": "MIT",
  "homepage": "https://lightstart.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alantriesagain/light.git",
    "directory": "packages/devices"
  },
  "bugs": {
    "url": "https://github.com/alantriesagain/light/issues"
  },
  "keywords": [
    "devices",
    "bluetooth",
    "ble",
    "wifi",
    "camera",
    "light"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "index.ts",
    "types.ts",
    "signals.js",
    "commands.js",
    "capabilities.js",
    "events.js",
    "controllers/",
    "lib/",
    "views/",
    "android/",
    "tags.json",
    "README.md",
    "AGENTS.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./index.ts",
    "./*": "./*"
  },
  "light": {
    "tags": "tags.json",
    "android": {
      "sources": "android",
      "entry": "DevicesAddon",
      "permissions": [
        { "name": "android.permission.BLUETOOTH_SCAN", "usesPermissionFlags": "neverForLocation" },
        "android.permission.BLUETOOTH_CONNECT",
        { "name": "android.permission.BLUETOOTH", "maxSdkVersion": 30 },
        { "name": "android.permission.BLUETOOTH_ADMIN", "maxSdkVersion": 30 },
        { "name": "android.permission.ACCESS_FINE_LOCATION", "maxSdkVersion": 30 },
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.CHANGE_WIFI_STATE",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CHANGE_NETWORK_STATE",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE"
      ],
      "dependencies": [
        "androidx.media3:media3-exoplayer:1.4.1",
        "androidx.media3:media3-datasource:1.4.1"
      ],
      "services": [
        { "name": "DeviceLinkService", "foregroundServiceType": "connectedDevice" }
      ]
    }
  },
  "dependencies": {
    "@lightstart/app": "workspace:*",
    "@lightstart/light": "workspace:*",
    "@lightstart/mobile": "workspace:*"
  },
  "peerDependencies": {
    "@lightstart/components": "workspace:*"
  },
  "devDependencies": {
    "@lightstart/test": "workspace:*",
    "@types/node": "^26.6.5",
    "typescript": "^6.0.3"
  }
}
