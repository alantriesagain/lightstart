{
  "name": "@lightstart/qr",
  "version": "0.1.0",
  "description": "A byte-mode QR encoder with SVG and terminal renderers, a reader that finds and decodes a QR code in a camera frame, and the qr-code component that draws one.",
  "type": "module",
  "types": "./types.ts",
  "license": "MIT",
  "homepage": "https://lightstart.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alantriesagain/light.git",
    "directory": "packages/qr"
  },
  "bugs": {
    "url": "https://github.com/alantriesagain/light/issues"
  },
  "keywords": [
    "qr",
    "qr-code",
    "barcode",
    "encoder",
    "decoder",
    "web-components",
    "light"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "index.ts",
    "types.ts",
    "encode.js",
    "decode.js",
    "svg.js",
    "terminal.js",
    "views/",
    "locales/",
    "tags.json",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./index.ts",
    "./*": "./*"
  },
  "light": {
    "tags": "tags.json",
    "locales": true
  },
  "dependencies": {
    "@lightstart/components": "workspace:*",
    "@lightstart/light": "workspace:*"
  },
  "devDependencies": {
    "@lightstart/build": "workspace:*",
    "@lightstart/test": "workspace:*",
    "@types/node": "^26.6.5",
    "typescript": "^6.0.3"
  }
}
