{
  "name": "@lightstart/play-billing",
  "version": "0.1.0",
  "description": "Paying through Google Play: purchases verified on the server, Play's real-time notifications, the checkout view and the Android add-on, as a @lightstart/billing method.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://lightstart.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alantriesagain/light.git",
    "directory": "packages/play-billing"
  },
  "bugs": {
    "url": "https://github.com/alantriesagain/light/issues"
  },
  "keywords": [
    "google-play",
    "billing",
    "android",
    "payments",
    "light"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "index.ts",
    "types.ts",
    "commands.ts",
    "server/",
    "page/",
    "locales/",
    "android/",
    "tags.json",
    "README.md",
    "AGENTS.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./index.ts",
    "./server": "./server/index.ts",
    "./page": "./page/index.ts",
    "./*": "./*"
  },
  "dependencies": {
    "@lightstart/api": "workspace:*",
    "@lightstart/app": "workspace:*",
    "@lightstart/auth": "workspace:*",
    "@lightstart/billing": "workspace:*",
    "@lightstart/light": "workspace:*",
    "@lightstart/mobile": "workspace:*"
  },
  "devDependencies": {
    "@lightstart/app": "workspace:*",
    "@lightstart/server": "workspace:*",
    "@lightstart/sqlite": "workspace:*",
    "@lightstart/test": "workspace:*",
    "@types/node": "^26.6.5",
    "typescript": "^6.0.3"
  },
  "light": {
    "server": "./server/contribute.ts",
    "tags": "tags.json",
    "locales": true,
    "android": {
      "sources": "android",
      "entry": "PlayBillingAddon",
      "permissions": [
        "com.android.vending.BILLING"
      ],
      "dependencies": [
        "com.android.billingclient:billing:8.3.0"
      ]
    }
  }
}
