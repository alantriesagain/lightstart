{
  "name": "light-website",
  "version": "0.1.0",
  "type": "module",
  "bootstrapp": {
    "prefix": "docs",
    "name": "Light",
    "short_name": "Light",
    "description": "The site of light: every component, its examples and its props, in any skin",
    "theme_color": "#101210",
    "bodyClasses": "bg-canvas text-default min-h-screen",
    "dev": {
      "port": 3530
    },
    "database": {
      "name": "light-website",
      "version": 1,
      "defaultAdapter": "indexeddb"
    },
    "components": {
      "docs": "views/",
      "template": "views/templates/"
    },
    "generator": {
      "styling": "css"
    },
    "theme": {
      "path": "/theme.js",
      "runtime": true,
      "icon": {
        "family": "lucide"
      }
    }
  },
  "scripts": {
    "dev": "bootstrapp serve",
    "test": "bootstrapp test"
  },
  "dependencies": {
    "@bootstrapp/light": "workspace:*",
    "@bootstrapp/showcase": "workspace:*",
    "bootstrapp": "workspace:*",
    "@bootstrapp/theme": "workspace:*",
    "@bootstrapp/editor": "workspace:*",
    "@bootstrapp/anim": "workspace:*",
    "@bootstrapp/qr": "workspace:*"
  },
  "devDependencies": {
    "@bootstrapp/test": "workspace:*",
    "@bootstrapp/cli": "workspace:*",
    "@bootstrapp/check": "workspace:*",
    "@bootstrapp/devops": "workspace:*",
    "@bootstrapp/generator": "workspace:*",
    "@bootstrapp/serve": "workspace:*"
  }
}
