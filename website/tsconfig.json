{
  "compilerOptions": {
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "lib": ["es2024", "dom", "dom.iterable"],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noImplicitAny": false,
    "useUnknownInCatchVariables": false,
    "exactOptionalPropertyTypes": false,
    "isolatedModules": false,
    "verbatimModuleSyntax": false,
    "paths": {
      "/controllers/*": ["./controllers/*"],
      "/views/*": ["./views/*"],
      "/models/*": ["./models/*"],
      "/lib/*": ["./lib/*"],
      "/locales/*": ["./locales/*"],
      "/theme.js": ["./theme.js"],
      "/app/*": ["./node_modules/@bootstrapp/*"]
    }
  },
  "include": [
    ".bootstrapp/globals.d.ts",
    ".bootstrapp/controllers.d.ts",
    ".bootstrapp/routes.d.ts",
    ".bootstrapp/components.d.ts",
    ".bootstrapp/schemas.d.ts",
    ".bootstrapp/events.d.ts",
    ".bootstrapp/commands.d.ts",
    "types.ts",
    "*.js",
    "controllers/**/*.js",
    "views/**/*.js",
    "models/**/*.js",
    "lib/**/*.js",
    "locales/**/*.js"
  ],
  "exclude": ["node_modules", ".deployed", "native/**", "content/**", "prod.js", "lib/**/*.test.js", "scripts/**", "tests/**"]
}
