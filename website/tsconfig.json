{
  "compilerOptions": {
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2024", "dom", "dom.iterable"],
    "strict": true,
    "noImplicitAny": false,
    "useUnknownInCatchVariables": false,
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["src", "lib", "types.ts", ".light"],
  "exclude": ["node_modules", "dist", ".deployed", "native-examples", "scripts", "lib/**/*.test.js"]
}
